# PYTHON
alias py="python"

alias pss="ps -s | grep 'dotnet\|node'"
alias ss="pss"
knet() {
    kill $(ps aux | grep dotnet | awk '{print $1}')
}
knode() {
    kill $(ps aux | grep node | awk '{print $1}')
    kp 4200
    kp 4300
    kp 5300
}
alias kall="knet;knode"
